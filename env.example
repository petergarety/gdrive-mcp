# Google Docs MCP Server - Configuration
# Copy this file to .env and update with your actual values

# === LOCAL MCP SERVER (Recommended for Cursor) ===
# Option 1: Service Account (Recommended)
# Download service account JSON from Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_PATH=/path/to/your/service-account-key.json
# OR provide the JSON directly as a string:
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Option 2: OAuth Credentials (Alternative)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# === CLOUDFLARE WORKERS (For HTTPS MCP deployment) ===
# These are required when deploying to Cloudflare Workers
GOOGLE_REDIRECT_URI=https://your-worker.your-subdomain.workers.dev/callback

# === GENERAL SETTINGS ===
MCP_LOG_LEVEL=DEBUG
NODE_ENV=development