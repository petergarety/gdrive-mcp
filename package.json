{
  "name": "gdrive-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server for Google Drive integration, deployable to Cloudflare Workers",
  "type": "module",
  "main": "dist/mcp-server.js",
  "scripts": {
    "build": "tsc && wrangler types",
    "build:mcp": "tsc",
    "start:mcp": "node dist/mcp-server.js",
    "dev:worker": "wrangler dev --env dev",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env dev",
    "types": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-drive",
    "google-docs",
    "cloudflare-workers",
    "ai",
    "automation"
  ],
  "author": "Peter Garety",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.2",
    "dotenv": "^17.2.1",
    "google-auth-library": "^10.2.1",
    "googleapis": "^144.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@eslint/js": "^9.17.0",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.29.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
